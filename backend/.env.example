# Groq API key — https://console.groq.com/keys
GROQ_API_KEY=

# Optional: override default Groq model (must support tool calling)
GROQ_MODEL=llama-3.3-70b-versatile

# MCP server URL (must match mcp-server port)
MCP_SERVER_URL=http://localhost:8001

# Backend server configuration
HOST=0.0.0.0
PORT=8000

# HTTP timeout for MCP tool calls (seconds)
REQUEST_TIMEOUT_SECONDS=15
